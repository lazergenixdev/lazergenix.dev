// eval $(odin run . -- PASS INPUT OUTPUT)
package encrypt;
import "core:fmt"
import "core:os"
import "core:crypto/sha2"
import "core:encoding/hex"

SALT :: [] u8 {
	0x2b, 0x6c, 0xfb, 0xe4, 0xcd, 0x7c, 0xef, 0x5f,
	0x89, 0xe8, 0xe3, 0xab, 0x98, 0x52, 0xe5, 0x48,
	0xed, 0xd9, 0x73, 0xb5, 0x22, 0x7e, 0x83, 0x3a,
	0xd8, 0x79, 0x88, 0xe7, 0x0c, 0x69, 0x57, 0x4c,
	0xda, 0x1d, 0x68, 0x6d, 0x54, 0x5b, 0xed, 0x3b,
	0x46, 0xf2, 0xf1, 0xed, 0x03, 0xd1, 0xef, 0x11,
	0xc9, 0x26, 0x6d, 0xc5, 0x96, 0x0b, 0x97, 0x9c,
	0x2d, 0x6a, 0x21, 0xb4, 0x6f, 0x94, 0x28, 0xc6
};

IV :: "2bc301a3d5e0ae1ccd3eee5848f9c760";

main :: proc()
{
	pass := os.args[1];
	input := os.args[2];
	output := os.args[3];
	
	key := make_key(pass);
	fmt.printf("openssl enc -d -aes-256-cbc -K {} -iv {} -in {} -out {}", to_hex(key), IV, input, output);
}

make_key :: proc(password: string) -> [] u8
{
	sha256: sha2.Context_256;
	sha2.init_256(&sha256);

	sha2.update(&sha256, transmute([] u8) password);
	sha2.update(&sha256, SALT);
	sha2.update(&sha256, transmute([] u8) password);
	
	hash := make([] u8, 32);
	sha2.final(&sha256, hash);
	return hash;
}

to_hex :: proc(data: [] u8) -> string
{
	return string(hex.encode(data));
}
